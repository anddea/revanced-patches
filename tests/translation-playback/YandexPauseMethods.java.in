package app.morphe.extension.youtube.patches.voiceovertranslation;

import app.morphe.extension.youtube.settings.Settings;
import app.morphe.extension.youtube.shared.VideoInformation;
import app.morphe.extension.shared.utils.Logger;
import app.morphe.extension.shared.utils.Utils;

import java.util.concurrent.atomic.*;

class YandexPauseBoundaries {
    static String pendingVideoId = "a", pendingVideoTitle = "title", toast;
    static long pendingVideoLength = 100000;
    static boolean pendingIsLive;
    static AtomicLong translationRequestGeneration = new AtomicLong(1);
    static AtomicBoolean isTranslating = new AtomicBoolean();
    static AtomicReference<String> currentTranslatedVideoId = new AtomicReference<>("a");
    static long playbackRecoveryRequestId = -1L;
    static MediaPlayer pendingSeekStartPlayer;
    static boolean shortsPlaybackPaused, active;
    static int clears, notified, requests, toggles;
    static long requestGeneration;
    static double requestedDuration;
    static String requestedId, requestedTitle, requestedSource, requestedTarget;
    static AtomicReference<MediaPlayer> mediaPlayer = new AtomicReference<>();
    static boolean isPaused;
    static Handler mainHandler = new Handler();
    static Runnable proxyPrepareTimeoutRunnable = () -> {};

    static class Handler {
        int removed;
        void removeCallbacks(Runnable r) { removed++; }
    }

    static class MediaPlayer {
        java.util.function.Consumer<MediaPlayer> seekCompleted;
        boolean playing, delaySeek, failSeek;
        int starts, pauses, position, speedUpdates, seeks, pendingSeekPosition;
        float volume;
        boolean isPlaying() { return playing; }
        int getDuration() { return 1000000; }
        void start() { starts++; playing = true; }
        void pause() { pauses++; playing = false; }
        void setOnSeekCompleteListener(java.util.function.Consumer<MediaPlayer> listener) { seekCompleted = listener; }
        void seekTo(int time) {
            if (failSeek) throw new IllegalStateException("seek");
            seeks++;
            if (delaySeek) {
                pendingSeekPosition = time;
            } else {
                position = time;
                if (seekCompleted != null) seekCompleted.accept(this);
            }
        }
        void finishSeek() {
            if (!delaySeek) throw new AssertionError("No delayed seek pending");
            delaySeek = false;
            position = pendingSeekPosition;
            if (seekCompleted != null) seekCompleted.accept(this);
        }
        void setVolume(float left, float right) { volume = left; }
    }

    static void applyPlaybackSpeedToPlayer(MediaPlayer player) {
        player.speedUpdates++;
        // Android setPlaybackParams can start a prepared or paused MediaPlayer.
        player.playing = true;
    }

    static void stopAudioPlayback() {
        pendingSeekStartPlayer = null;
        if (mediaPlayer.get() != null) mediaPlayer.get().playing = false;
        mediaPlayer.set(null);
        active = false;
        notifyTranslationStateChanged();
    }
    static int fallbackStarts;
    static String fallbackAudioUrl;
    static void startAudioPlayback(long requestId, String videoId, String audioUrl, String fallbackUrl) {
        fallbackStarts++;
        fallbackAudioUrl = audioUrl;
        active = true;
    }
    static String str(String key) { return "localized:" + key; }
    static void showToastShort(String message) { toast = message; }

    static void clearTranslationRequestProgress() {
        clears++;
    }

    static void notifyTranslationStateChanged() {
        notified++;
    }

    static void requestTranslation(
            String id,
            String title,
            String source,
            String target,
            double duration,
            long generation,
            VotAudioUploadState state) {
        if (state == null) throw new AssertionError("Missing request state");
        requests++;
        requestGeneration = generation;
        requestedDuration = duration;
        requestedId = id; requestedTitle = title; requestedSource = source; requestedTarget = target;
    }

    static boolean isTranslationActive() {
        return active;
    }

    static boolean isTranslationRequestInProgress() {
        return isTranslating.get();
    }


    static class VotAudioUploadState {}

    static class RootView {
        static boolean shorts;

        static boolean isShortsActive() {
            return shorts;
        }
    }

}

public class YandexPauseMethods extends YandexPauseBoundaries {
    // PRODUCTION_METHODS
}
